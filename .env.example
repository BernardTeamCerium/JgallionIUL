# Where form submissions are POSTed as JSON (server-side only). For OnRadar CRM:
# https://<onradar host>/api/leads/<clientId>/inbound?key=<inbound key>
LEAD_WEBHOOK_URL=
# Public site address, used for social preview images
SITE_URL=https://jgallionfinancial.com

# Email via Resend (optional). Verify your sending domain at resend.com/domains first.
RESEND_API_KEY=
# Must use the verified domain, e.g. "Jaden Gallion <jaden@jgallionfinancial.com>"
EMAIL_FROM=
# Where replies to the guide email go (optional; defaults to EMAIL_FROM)
EMAIL_REPLY_TO=
# Who gets an email for each new lead (optional; also counts as lead delivery if no webhook is set)
LEAD_NOTIFY_EMAIL=
