# Where form submissions are POSTed as JSON (server-side only). For OnRadar CRM:
# https://<onradar host>/api/leads/<clientId>/inbound?key=<inbound key>
LEAD_WEBHOOK_URL=
# Public site address, used for social preview images
SITE_URL=https://jgallionfinancial.com

# New-lead alerts to Jaden (optional; each one is on when its values are set)
# Email via Resend (resend.com). Without EMAIL_FROM, alerts come from Resend's test sender, which only
# delivers to the email address the Resend account was created with.
RESEND_API_KEY=
# Comma-separated recipients and blind copies, e.g.
# LEAD_NOTIFY_EMAIL=rsoto@retireaef.com, prusso@retireaef.com
# LEAD_NOTIFY_BCC=bernard@teamcerium.com
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_BCC=
# Required to email anyone other than the Resend account owner, on a domain verified in Resend
EMAIL_FROM=
# Text via Twilio (twilio.com). TWILIO_FROM is your Twilio number; LEAD_NOTIFY_PHONE is your cell, e.g. +15555550123
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
LEAD_NOTIFY_PHONE=
